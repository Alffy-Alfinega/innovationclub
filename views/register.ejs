<%- include('partials/header') %>

<section class="section form-section">
  <div class="section-header">
    <span class="section-label">Register</span>
    <h2>Join Innovation Club.<br /><span class="blue">A few steps away.</span></h2>
    <p class="section-desc" style="max-width:500px;margin-top:1rem">Fill in the details below to register. We'll follow up within 48 hours.</p>
  </div>

  <% if (errors.length > 0) { %>
    <div class="error-box">
      <ul>
        <% errors.forEach(function(err) { %>
          <li><%= err %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/register" class="register-form">

    <div class="form-group">
      <label>Full Name</label>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="firstName">First Name *</label>
        <input type="text" id="firstName" name="firstName" value="<%= form.firstName || '' %>" required minlength="2" placeholder="e.g. Nakato" />
      </div>
      <div class="form-group">
        <label for="middleName">Middle Name</label>
        <input type="text" id="middleName" name="middleName" value="<%= form.middleName || '' %>" placeholder="e.g. Grace" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="lastName">Last Name *</label>
        <input type="text" id="lastName" name="lastName" value="<%= form.lastName || '' %>" required minlength="2" placeholder="e.g. Brenda" />
      </div>
      <div class="form-group">
        <label for="otherName">Other Name</label>
        <input type="text" id="otherName" name="otherName" value="<%= form.otherName || '' %>" placeholder="e.g. Nickname" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="gender">Gender</label>
        <select id="gender" name="gender">
          <option value="">Select gender</option>
          <option value="Male" <%= form.gender === 'Male' ? 'selected' : '' %>>Male</option>
          <option value="Female" <%= form.gender === 'Female' ? 'selected' : '' %>>Female</option>
        </select>
      </div>
      <div class="form-group">
        <label for="class">Class *</label>
        <select id="class" name="class" required onchange="updateStreams()">
          <option value="">Select class</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c %>" <%= form.class === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="stream">Stream</label>
        <select id="stream" name="stream">
          <option value="">Select stream</option>
        </select>
      </div>
      <div class="form-group">
        <label for="studentStatus">Status</label>
        <select id="studentStatus" name="studentStatus">
          <option value="">Select status</option>
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= form.studentStatus === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="termJoined">Term Joined</label>
        <select id="termJoined" name="termJoined">
          <option value="">Select term</option>
          <% terms.forEach(function(t) { %>
            <option value="<%= t %>" <%= form.termJoined === t ? 'selected' : '' %>><%= t %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="schoolName">School</label>
        <input type="text" id="schoolName" name="schoolName" value="<%= form.schoolName || school %>" readonly />
      </div>
    </div>

    <div class="form-group">
      <label>Contact Information</label>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" placeholder="e.g. brenda@example.com" />
      </div>
      <div class="form-group">
        <label for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" value="<%= form.phone || '' %>" placeholder="e.g. +256 7XX XXX XXX" />
      </div>
    </div>

    <div class="form-group">
      <label>Clubs & Programs</label>
      <div class="checkbox-grid">
        <label class="checkbox-label">
          <input type="checkbox" name="innovationClub" <%= form.innovationClub === 'on' ? 'checked' : '' %> />
          <span>Innovation Club</span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" name="aiClub" <%= form.aiClub === 'on' ? 'checked' : '' %> />
          <span>AI Club</span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" name="iscc" <%= form.iscc === 'on' ? 'checked' : '' %> />
          <span>ISCC (International Science & Computing Competition)</span>
        </label>
      </div>
    </div>

    <div class="form-group agree-group">
      <label class="checkbox-label">
        <input type="checkbox" name="agree" value="1" <%= form.agree ? 'checked' : '' %> required />
        <span>I confirm the information above is accurate and I agree to the <a href="#">terms of participation</a>. *</span>
      </label>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-full">Submit Registration →</button>
  </form>
</section>

<script>
const streamMap = <%- JSON.stringify(streams) %>;

function updateStreams() {
  const cls = document.getElementById('class').value;
  const sel = document.getElementById('stream');
  sel.innerHTML = '<option value="">Select stream</option>';
  if (cls && streamMap[cls]) {
    streamMap[cls].forEach(function(s) {
      const opt = document.createElement('option');
      opt.value = s;
      opt.textContent = s;
      if ('<%= form.stream || "" %>' === s) opt.selected = true;
      sel.appendChild(opt);
    });
  }
}
document.addEventListener('DOMContentLoaded', updateStreams);
</script>

<%- include('partials/footer') %>
