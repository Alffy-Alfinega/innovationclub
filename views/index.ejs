        <div><span class="stat-num">100%</span><p class="stat-label">Free to Join</p></div>
        <div><span class="stat-num">24/7</span><p class="stat-label">Mentor Support</p></div>
        <div><span class="stat-num gold">5★</span><p class="stat-label">Program Quality</p></div>
      </div>
    </div>
  </div>

