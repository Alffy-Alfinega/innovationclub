<%- include('partials/header') %>

<section class="section success-section">
  <div class="success-icon">✓</div>
  <div class="section-header" style="text-align:center">
    <h2>You're Registered!<br /><span class="blue">Welcome, <%= name %>.</span></h2>
    <p class="section-desc" style="max-width:500px;margin:1rem auto 0">Thank you for joining the Young Innovators program. Our team at Alffy will be in touch within 48 hours with next steps.</p>
  </div>

  <div class="cards cards-2" style="margin-top:2rem;max-width:600px;margin-left:auto;margin-right:auto">
    <div class="card" style="text-align:left">
      <span class="card-number">What happens next</span>
      <ol>
        <li>We review your registration and match you with a mentor based on your interest areas.</li>
        <li>You'll receive a welcome email with program materials and your mentor's contact.</li>
        <li>Start your innovation journey — workshops, projects, and mentorship, all free.</li>
      </ol>
    </div>
  </div>

  <div class="hero-btns" style="justify-content:center;margin-top:2rem">
    <a href="/" class="btn btn-primary">Back to Home</a>
  </div>
</section>

<%- include('partials/footer') %>
