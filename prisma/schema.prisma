generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // e.g. "makindye" — used in URLs and school-scoped queries
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  students Student[]

  @@map("schools")
}

// ─────────────────────────────────────────────
// Identity & roles
// ─────────────────────────────────────────────

enum Role {
  ADMIN            // was SUPER_ADMIN — Alfinega, cross-school, no schoolId scope
  SYSTEM_OPERATOR  // was SCHOOL_ADMIN — scoped to one School
  PATRON           // was MENTOR — scoped to one School (Ugandan school-club terminology: the staff member who supervises a club)
  STUDENT          // was PARENT — scoped to one School; the student's OWN login, not a guardian's
  BREAK_GLASS      // emergency-only account; every use must be logged, see AuditLog
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role
  school        School?   @relation(fields: [schoolId], references: [id])
  schoolId      String?   // null only for SUPER_ADMIN and BREAK_GLASS
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // A parent account may be linked to one or more students (siblings)
  studentLinks  StudentLink[]
  auditLogs     AuditLog[]

  @@index([schoolId])
  @@map("users")
}

// Explicit join table (not a loose FK) so a parent can have multiple children
// and a student can — in theory — have multiple guardians with portal access.
// Links a STUDENT-role account to their own Student record. Kept as an
// explicit join (not a 1:1 FK) so the shape can support future cases —
// e.g. a sibling pair, or reintroducing guardian access later — without
// another schema migration. Named/renamed 2026-07-06 when the role
// changed from PARENT (guardian-monitoring) to STUDENT (self-access):
// was ParentStudent.parentId, now StudentLink.userId.
model StudentLink {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@unique([userId, studentId])
  @@map("student_links")
}

// ─────────────────────────────────────────────
// Students (carried forward from the Express app's schema, normalized)
// ─────────────────────────────────────────────

enum StudentStatus {
  DAY_SCHOLAR
  BOARDING_SCHOLAR
}

model Student {
  id             String        @id @default(cuid())
  school         School        @relation(fields: [schoolId], references: [id])
  schoolId       String
  firstName      String
  middleName     String?
  lastName       String
  otherName      String?
  gender         String?
  className      String        // "Form 1", "Form 2", etc. — kept as string, see brain/database for enum discussion
  stream         String?
  status         StudentStatus?
  termJoined     String?
  email          String?
  phone          String?
  innovationClub Boolean       @default(false)
  aiClub         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  linkedUsers    StudentLink[]

  @@index([schoolId])
  @@map("students")
}

// ─────────────────────────────────────────────
// Audit — mandatory for BREAK_GLASS, useful for everyone
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String   // e.g. "BREAK_GLASS_LOGIN", "STUDENT_UPDATE", "STUDENT_DELETE"
  detail    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
